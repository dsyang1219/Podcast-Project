# Local environments, editor state, secrets
.venv/
.venv-tlda/
.vscode/
.env
__pycache__/
*.pyc

# Audio and transcripts: the corpus of record is regenerable from the frozen
# chart + sampling manifests + step3_transcribe/; too large for git.
data/audio_queue/
data/transcripts/
data/cache/

# Third-party and restricted data (Kettering-Gallup and Pew microdata, the
# Brookings export, DIME files, Brysbaert norms, podcastindex). Obtain under
# the relevant agreements; see README "Data availability". Our own word lists
# under data/external/dictionaries/ ARE committed.
data/external/*
!data/external/dictionaries/

